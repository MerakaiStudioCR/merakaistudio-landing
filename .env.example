# Copia a .env y ajusta valores

# URL pública del sitio. La usan sitemap, robots, canonical y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo visible en el pie. Si queda vacío, el sitio no muestra un correo.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Redes visibles en el pie. Si quedan vacías, no se muestran.
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_X=

# Envío del formulario. Sin estas cuatro variables, el formulario responde
# que el correo no está configurado y no simula un envío exitoso.
# CONTACT_EMAIL_PROVIDER=resend
# CONTACT_TO=
# CONTACT_FROM=
# RESEND_API_KEY=

# API externa. El sitio corporativo funciona sin ella.
# API_BASE_URL=
# INTERNAL_API_KEY=

# Mapas (opcional, kit heredado)
# NEXT_PUBLIC_GOOGLE_API_KEY=
